<?xml version="1.0" encoding="utf-8"?>
<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
  <vertical pad="10" spacing="6">
    <text text="Performance" font-size="5" align="Center"/>
    <toggle-setting id="LimitIncomingAvatarDataToggle" value="LimitIncomingAvatarDataDuringSongsDraft"/>
    <text text="When enabled, limit non critical data when playing songs. Can help with performance, more settings coming soon." font-size="3.5" align="Center"/>
    <button text="Apply" pad="2" on-click="ApplyClicked"/>
  </vertical>
</bg>
