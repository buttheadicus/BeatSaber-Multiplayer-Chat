<?xml version="1.0" encoding="utf-8"?>
<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
  <vertical id="player_grid_root" pad="8" spacing="4" horizontal-fit="PreferredSize">
    <text id="GridTitle" text="" font-size="4" align="Center"/>
    <button id="VoiceModeSwitchButton" text="Talk to" on-click="VoiceModeSwitchClicked"/>
    <text id="GridHint" text="Tap a name" font-size="3" align="Center"/>
    <vertical id="VolumeAdjustPanel" pad="2" spacing="2">
      <text id="VolumePlayerLabel" text="" font-size="3.5" align="Center"/>
      <horizontal id="VolumeStepRow" spacing="3" horizontal-fit="PreferredSize">
        <button id="PlayerVolumeDownButton" text="-" pad="2" on-click="PlayerVolumeDownClicked"/>
        <text id="PlayerVolumeStepLabel" text="1.0" font-size="4" align="Center"/>
        <button id="PlayerVolumeUpButton" text="+" pad="2" on-click="PlayerVolumeUpClicked"/>
      </horizontal>
    </vertical>
    <horizontal spacing="2">
      <button id="Slot0" on-click="OnSlot0"/>
      <button id="Slot1" on-click="OnSlot1"/>
      <button id="Slot2" on-click="OnSlot2"/>
    </horizontal>
    <horizontal spacing="2">
      <button id="Slot3" on-click="OnSlot3"/>
      <button id="Slot4" on-click="OnSlot4"/>
      <button id="Slot5" on-click="OnSlot5"/>
    </horizontal>
    <horizontal spacing="2">
      <button id="Slot6" on-click="OnSlot6"/>
      <button id="Slot7" on-click="OnSlot7"/>
      <button id="Slot8" on-click="OnSlot8"/>
    </horizontal>
    <horizontal spacing="2">
      <button id="Slot9" on-click="OnSlot9"/>
      <button id="Slot10" on-click="OnSlot10"/>
      <button id="Slot11" on-click="OnSlot11"/>
    </horizontal>
    <button id="SaveVolumesButton" text="Save volumes and close" on-click="SaveVolumesAndCloseClicked"/>
    <button id="ClearAllMutesButton" text="Unmute all players" on-click="ClearAllMutesClicked"/>
  </vertical>
</bg>
