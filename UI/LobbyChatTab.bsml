<?xml version="1.0" encoding="utf-8"?>
<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
  <vertical pad="3" spacing="2">
    <text text="Multiplayer Chat BETA-v0.3.7-E" font-size="4" align="Center"/>
    <horizontal spacing="3" child-align="UpperLeft" id="LobbyTopRow">
      <vertical spacing="1" id="VoiceMessageButtonsColumn">
        <button id="RecordButton" text="RECORD" on-click="RecordClicked"/>
        <button id="VoicePlayButton" text="PLAY" on-click="PlayVoiceClicked"/>
        <button id="VoiceSendButton" text="SEND" on-click="SendVoiceClicked"/>
      </vertical>
      <vertical spacing="2" id="ChatColumn" child-expand-width="true">
        <horizontal spacing="2" child-align="MiddleCenter" id="VoiceUtilityRow">
          <button id="EndVoiceButton" text="End voice message" on-click="ForceEndVoiceClicked"/>
          <button id="ResetVoiceButton" text="Reset voice chat" on-click="ForceResetVoipClicked"/>
        </horizontal>
        <horizontal spacing="1" child-align="MiddleCenter">
          <text text="Message" font-size="3.5"/>
          <string-setting id="ChatInput" text="" show-buttons="false"/>
          <button text="Send" on-click="SubmitClicked"/>
        </horizontal>
      </vertical>
    </horizontal>
    <horizontal spacing="2">
      <button id="DeafButton" text="Deaf" on-click="DeafClicked"/>
      <button id="VoiceHotMicMuteButton" text="Mute mic" on-click="VoiceHotMicMuteClicked"/>
      <button id="HearButton" text="Hear" on-click="HearClicked"/>
      <button id="DMButton" text="DM" on-click="DMClicked"/>
    </horizontal>
    <horizontal spacing="2">
      <button id="MutePlayerButton" text="Mute Player" on-click="MutePlayerClicked"/>
      <button id="SettingsButton" text="Settings" on-click="SettingsClicked"/>
    </horizontal>
  </vertical>
</bg>
