<?xml version="1.0" encoding="utf-8"?>
<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
  <vertical pad="6" spacing="4">
    <text text="WARNING" font-size="5" align="Center"/>
    <text id="WarningBody" text="WARNING: ALL FEATURES UNDER EXPERIMENTAL HAVE THE POSSIBILITY OF BREAKING UI, CAUSING UNSTABLE SERVER CONNECTION, OR CRASHING BEATSABER ALL TOGETHER. PRESSING ACCEPT MEANS YOU UNDERSTAND THE RISKS. (seriously, some BS will probably happen (get it??? BS? like beatsaber?))" font-size="3.2" align="Center" enable-word-wrapping="true"/>
    <button text="ACCEPT" pad="2" min-width="48" on-click="AcceptClicked"/>
  </vertical>
</bg>
