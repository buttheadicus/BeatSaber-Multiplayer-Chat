<?xml version="1.0" encoding="utf-8"?>
<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
  <vertical pad="8" spacing="5">
    <text text="Chat for non chat players" font-size="5" align="Center"/>
    <text text="Creates a custom song whose title is your message, so players without chat can still see it in the song list." font-size="3.2" align="Center" enable-word-wrapping="true"/>
    <string-setting id="ChatSongMessage" text="Message" value="ChatSongDraft" show-buttons="false"/>
    <button text="create chat song" pad="2" min-width="48" on-click="CreateChatSongClicked"/>
    <text id="ChatSongStatus" text="" font-size="3.2" align="Center" enable-word-wrapping="true"/>
  </vertical>
</bg>
