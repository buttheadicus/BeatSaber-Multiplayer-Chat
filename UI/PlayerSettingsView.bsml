<?xml version="1.0" encoding="utf-8"?>
<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
  <vertical pad="10" spacing="6">
    <slider-setting id="BubbleDuration" text="Chat bubble duration (seconds)" value="BubbleDuration" min="15" max="60" increment="1" show-value="true"/>
    <horizontal>
      <text text="Name color" font-size="4"/>
      <string-setting id="NameColorInput" text="HEX (6 chars)" value="NameColorHex" show-buttons="false"/>
    </horizontal>
    <horizontal child-expand-width="true">
      <toggle-setting id="ChatBubbleSoundsToggle" text="Chat bubble sounds" value="ChatBubbleSoundsEnabled"/>
    </horizontal>
    <button text="Apply" pad="2" on-click="ApplyClicked"/>
  </vertical>
</bg>
