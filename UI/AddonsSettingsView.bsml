<?xml version="1.0" encoding="utf-8"?>
<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
  <vertical pad="10" spacing="6">
    <button text="Avatar Coloring Extensions" pad="2" min-width="48" on-click="AvatarColoringClicked"/>
    <button text="Custom Avatars" pad="2" min-width="36" on-click="CustomAvatarsClicked"/>
    <button text="Quick Binds setup" pad="2" min-width="36" on-click="QuickBindsClicked"/>
    <button text="Apply" pad="2" on-click="ApplyClicked"/>
  </vertical>
</bg>
