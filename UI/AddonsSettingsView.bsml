<?xml version="1.0" encoding="utf-8"?>

<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"

    xsi:noNamespaceSchemaLocation="https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">

  <vertical pad="10" spacing="6">

    <button id="QuickBindsButton" text="Quick Binds" pad="2" min-width="48" on-click="QuickBindsClicked"/>

    <button id="AvatarColoringButton" text="Avatar Coloring Extensions" pad="2" min-width="48" on-click="AvatarColoringClicked"/>

    <button id="CustomAvatarsButton" text="Custom Avatars" pad="2" min-width="48" on-click="CustomAvatarsClicked"/>

  </vertical>

</bg>

