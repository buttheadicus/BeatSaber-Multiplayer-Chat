<?xml version="1.0" encoding="utf-8"?>
<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
  <vertical pad="10" spacing="6">
    <toggle-setting id="DuckEnabledToggle" text="Enabled" value="DuckEnabledDraft"/>
    <text text="Set game volume while a player is speaking (incoming hot mic or voice message). Chat voice stays clear; ramps after 1 s of continuous voice, restores 1 s after it ends." font-size="3" align="Center"/>
    <horizontal spacing="3" horizontal-fit="PreferredSize">
      <button id="DuckVolDown" text="-" pad="2" on-click="DuckVolumeDownClicked"/>
      <text id="DuckVolumeStepLabel" text="35%" font-size="4" align="Center"/>
      <button id="DuckVolUp" text="+" pad="2" on-click="DuckVolumeUpClicked"/>
    </horizontal>
    <text text="Lower = quieter game during duck (5%–100%). Use Apply to save; leaving without Apply discards changes." font-size="3" align="Center"/>
    <button text="Apply" pad="2" on-click="ApplyClicked"/>
  </vertical>
</bg>
