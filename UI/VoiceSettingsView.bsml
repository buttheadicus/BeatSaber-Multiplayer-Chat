<?xml version="1.0" encoding="utf-8"?>
<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
  <vertical pad="10" spacing="4">
    <dropdown-list-setting id="MicInput" text="Mic input:" options="MicOptions"/>
    <toggle-setting id="PushToTalkToggle" text="Push to talk" value="PushToTalk"/>
    <dropdown-list-setting id="PttBindDropdown" text="PTT button" options="PttOptions"/>
    <horizontal spacing="6" horizontal-fit="PreferredSize">
      <text text="Lower volume when player speaks" font-size="3.5" align="Left"/>
      <button text="Configure" pad="2" on-click="ConfigureLowerVolumeWhenSpeakingClicked"/>
    </horizontal>
    <toggle-setting id="MuteMicDuringSongToggle" text="Mute mic during song" value="MuteMicDuringSong"/>
    <toggle-setting id="DeafDuringSongToggle" text="Deafen during song" value="DeafDuringSong"/>
    <button text="APPLY" on-click="ApplyClicked"/>
  </vertical>
</bg>
