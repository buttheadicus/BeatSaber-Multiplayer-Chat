<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MultiplayerChat</AssemblyName>
    <RootNamespace>MultiplayerChat</RootNamespace>
    <Version>0.3.6</Version>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net472</TargetFramework>
    <BeatSaberDir>F:\bsmanager\BSManager\BSInstances\1.40.8 (test)</BeatSaberDir>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS0618;CS1591;CS0649;CS0436</NoWarn>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <TieredCompilation Condition="'$(Configuration)' == 'Release'">true</TieredCompilation>
    <!-- nicoco007 plugin is usually CustomAvatar.dll; some installs use CustomAvatars.dll -->
    <CustomAvatarHintPath Condition="Exists('$(BeatSaberDir)\Plugins\CustomAvatar.dll')">$(BeatSaberDir)\Plugins\CustomAvatar.dll</CustomAvatarHintPath>
    <CustomAvatarHintPath Condition="'$(CustomAvatarHintPath)' == '' and Exists('$(BeatSaberDir)\Plugins\CustomAvatars.dll')">$(BeatSaberDir)\Plugins\CustomAvatars.dll</CustomAvatarHintPath>
    <CustomAvatarHintPath Condition="'$(CustomAvatarHintPath)' == ''">$(BeatSaberDir)\Plugins\CustomAvatar.dll</CustomAvatarHintPath>
  </PropertyGroup>
