  <Target Name="BuildAddonsRuntime" AfterTargets="Build">
    <MSBuild Projects="$(ProjectDir)MultiplayerChat.Addons\MultiplayerChat.Addons.csproj" Properties="Configuration=$(Configuration)" />
    <MakeDir Directories="$(ProjectDir)Embedded" />
    <Copy SourceFiles="$(ProjectDir)MultiplayerChat.Addons\bin\$(Configuration)\MultiplayerChat.Addons.dll" DestinationFolder="$(ProjectDir)Embedded\" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)MultiplayerChat.Addons\bin\$(Configuration)\MultiplayerChat.Addons.dll')" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="Embedded\MultiplayerChat.Addons.dll" Condition="Exists('Embedded\MultiplayerChat.Addons.dll')">
      <LogicalName>MultiplayerChat.Embedded.MultiplayerChat.Addons.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="CopyToBeatSaber" AfterTargets="BuildAddonsRuntime">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(BeatSaberDir)\Plugins\" SkipUnchangedFiles="true" Condition="Exists('$(BeatSaberDir)')" />
    <Copy SourceFiles="$(ProjectDir)MultiplayerChat.Addons\bin\$(Configuration)\MultiplayerChat.Addons.dll" DestinationFolder="$(BeatSaberDir)\Plugins\MultiplayerChat\" SkipUnchangedFiles="true" Condition="Exists('$(BeatSaberDir)') and Exists('$(ProjectDir)MultiplayerChat.Addons\bin\$(Configuration)\MultiplayerChat.Addons.dll')" />
    <MakeDir Directories="$(BeatSaberDir)\Plugins\MultiplayerChat\Addons" Condition="Exists('$(BeatSaberDir)')" />
  </Target>

  <!-- Release layout: manifest at root, Plugins/ dll (matches manifest files[]). -->
  <Target Name="CopyToReleasesFolder" AfterTargets="BuildAddonsRuntime" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ReleasesDir>$(ProjectDir)releases</ReleasesDir>
    </PropertyGroup>
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ReleasesDir)\Plugins\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)manifest.json" DestinationFolder="$(ReleasesDir)\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)version" DestinationFolder="$(ReleasesDir)\" SkipUnchangedFiles="true" />
  </Target>
