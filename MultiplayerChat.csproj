  <!-- Install into Beat Saber for testing (only if BeatSaberDir exists). -->
  <Target Name="CopyToBeatSaber" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(BeatSaberDir)\Plugins\" SkipUnchangedFiles="true" Condition="Exists('$(BeatSaberDir)')" />
  </Target>

  <!-- Release layout: manifest at root, Plugins/ dll (matches manifest files[]). -->
  <Target Name="CopyToReleasesFolder" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ReleasesDir>$(ProjectDir)releases</ReleasesDir>
    </PropertyGroup>
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ReleasesDir)\Plugins\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)manifest.json" DestinationFolder="$(ReleasesDir)\" SkipUnchangedFiles="true" />
  </Target>
